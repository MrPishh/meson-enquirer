#  Meson Enquirer settings. Edit a value, then: pm2 restart meson-bot
#  Every line must stay (the bot won't start if one is missing).
#  Full explanation of each setting: README.md -> "Settings".


# ==============================================================================
#   DISCORD
# ==============================================================================

# Bot token (Developer Portal -> Bot -> Reset Token)
BOT_TOKEN=

# Application ID (Developer Portal -> General Information)
APPLICATION_ID=

# Your server's ID, so /meson-query appears at once (blank = all servers, slower)
GUILD_ID=


# ==============================================================================
#   TICKETS
# ==============================================================================

# Category IDs, comma separated - the bot auto-replies only in channels under these
REPLY_CATEGORY_IDS=

# Staff role IDs, comma separated - their messages are ignored
STAFF_ROLE_IDS=

# How many Ticket Tool (bot) messages to read at the start of a ticket
AUTO_SCAN_MESSAGES=6


# ==============================================================================
#   WALLET ADDRESS LOOKUPS
# ==============================================================================

# Only list a wallet's unfinished swaps from the last this-many days
ADDRESS_LOOKBACK_DAYS=7

# Read at most this many pages of the wallet's swaps (20 swaps per page)
ADDRESS_MAX_PAGES=10


# ==============================================================================
#   FOLLOWING A SWAP UNTIL IT FINISHES
# ==============================================================================

# Check the swap every this-many seconds (0 = don't follow swaps).
# Also how often the shared check round runs: every swap that is due, in every
# ticket, is checked together in one request (up to 20 swaps per request).
SWAP_WATCH_INTERVAL_SECONDS=10

# After this many minutes, check less often...
SWAP_WATCH_SLOWER_AFTER_MINUTES=10

# ...every this-many seconds
SWAP_WATCH_SLOWER_INTERVAL_SECONDS=30

# After this many minutes (not less than the one above), check even less often...
SWAP_WATCH_SLOWEST_AFTER_MINUTES=60

# ...every this-many seconds
SWAP_WATCH_SLOWEST_INTERVAL_SECONDS=90

# Stop following after this many hours (keep it generous)
SWAP_WATCH_MAX_HOURS=48


# ==============================================================================
#   WHEN MESON'S SITE IS DOWN
# ==============================================================================

# Give up on one request after this many seconds
MESON_TIMEOUT_SECONDS=8

# Retry a failed request this many times (waits about 1s, 2s, 4s, ...)
MESON_RETRIES=3

# Then retry the whole ticket message until it works (it never gives up while the ticket is open,
# unless Discord refuses the bot's post, e.g. missing permissions),
# first after this many seconds, then twice as long each time...
TICKET_RETRY_SECONDS=5

# ...but never waiting longer than this many seconds between tries
TICKET_RETRY_MAX_SECONDS=60


# ==============================================================================
#   NETWORK NOTICE
# ==============================================================================

# An unfinished swap's details get a "⚠️ Network notice" when Meson reports
# none of its nodes for the swap's source or destination chain as healthy
# (rpcs.meson.fi). Re-check that at most this often, in seconds (one request
# covers every chain). 0 = no notices.
CHAIN_HEALTH_CACHE_SECONDS=60


# ==============================================================================
#   EXPLORER STATUS CHECK
# ==============================================================================

# The bot's statuses are a copy of the Meson explorer's own status function.
# Every this-many hours (and at startup) check that the explorer still uses the
# same logic; if Meson changed it, a warning is logged (pm2 logs) so the copy
# can be updated. 0 = never check.
EXPLORER_CHECK_HOURS=24


# ==============================================================================
#   RANDOM SPACING
# ==============================================================================

# Make every repeated wait above (swap re-checks, retries) randomly up to this
# many percent shorter or longer, so checks never come at a fixed beat
# (50 = a 10s check comes after 5-15s). 0 = exact intervals. At most 90.
JITTER_PERCENT=50
