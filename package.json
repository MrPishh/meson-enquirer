{
  "name": "meson-ticket-bot",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Discord bot that looks up Meson cross-chain swaps and posts the details into support tickets.",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "prestart": "node scripts/build-index.mjs",
    "start": "node src/index.js",
    "register": "node scripts/register-commands.mjs",
    "lookup": "node scripts/lookup.mjs",
    "lookup-address": "node scripts/lookup-address.mjs",
    "refresh-presets": "node scripts/refresh-presets.mjs",
    "check-explorer": "node scripts/check-explorer.mjs",
    "index": "node scripts/build-index.mjs",
    "index:watch": "node scripts/build-index.mjs --watch"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  }
}
